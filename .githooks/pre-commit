#!/bin/sh
set -e
python -m compileall -q eventhub tests scripts
python -m pytest -q
python grading/check_part3.py . >/dev/null
if git diff --cached --name-only | grep -Eq '^(eventhub/|templates/|static/)'; then
    if ! git diff --cached --name-only | grep -Eq '^(features/|docs/implementation-alignment\.md)'; then
        echo 'WARNING: application files changed without a staged specification or alignment note.' >&2
    fi
fi
